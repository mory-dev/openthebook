{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "Open PDF files with OpenTheBook",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "mimeType": "application/epub+zip",
        "name": "EPUB ebook",
        "description": "Open EPUB files with OpenTheBook",
        "role": "Viewer"
      },
      {
        "ext": ["azw3"],
        "mimeType": "application/vnd.amazon.ebook",
        "name": "AZW3 ebook",
        "description": "Open AZW3 files with OpenTheBook",
        "role": "Viewer"
      },
      {
        "ext": ["mobi"],
        "mimeType": "application/x-mobipocket-ebook",
        "name": "MOBI ebook",
        "description": "Open MOBI files with OpenTheBook",
        "role": "Viewer"
      }
    ]
  }
}
