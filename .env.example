# Local-only project configuration. Never commit real values.
# Release and deployment secrets belong in GitHub Actions or Cloudflare.

PUBLIC_SITE_URL=https://openthebook.lol
UPDATE_MANIFEST_URL=https://openthebook.lol/updates/latest.json
GITHUB_REPOSITORY=openthebook/openthebook

# Tauri updater signing (CI only; .env files are not used by Tauri builds)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Azure Artifact Signing / GitHub Actions secrets (CI only)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_ACCOUNT_NAME=
AZURE_CERT_PROFILE_NAME=
AZURE_ENDPOINT=https://eus.codesigning.azure.net/

# Cloudflare deployment secrets (CI only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
